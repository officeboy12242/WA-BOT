# WhatsApp Course Bot Configuration
# Copy this file to .env and configure your settings

# ============================================
# REQUIRED: WhatsApp Chat Configuration
# ============================================

# WhatsApp Group ID or Contact ID where courses will be posted
# 
# For Groups: Format is 1234567890@g.us
# For Contacts: Format is 1234567890@s.whatsapp.net
# 
# How to get this:
# 1. Run the bot first time (leave this empty)
# 2. Scan QR code with WhatsApp
# 3. Check the logs - bot will list all your groups
# 4. Copy the ID of your target group/contact
# 5. Paste it here and restart the bot
#
# Example: WHATSAPP_CHAT_ID=120363123456789012@g.us
WHATSAPP_CHAT_ID=

# ============================================
# OPTIONAL: Admin Panel
# ============================================

# Secret token for accessing the web admin panel
# Access the panel at: https://your-app.onrender.com/admin?token=YOUR_TOKEN
# Default: sassy123 (CHANGE THIS IN PRODUCTION!)
ADMIN_TOKEN=sassy123

# Public URL for expiring movie download short links (/d/:code)
# On Render this is auto-set via RENDER_EXTERNAL_URL — override only if needed
# PUBLIC_URL=https://your-app.onrender.com

# ============================================
# DEPLOY (Render / Koyeb) — /deploy command
# ============================================
# Set one platform's keys to enable /deploy:
#
# Render:
# RENDER_API_KEY=rnd_xxxxx
# RENDER_SERVICE_ID=srv-xxxxx
#
# Koyeb:
# KOYEB_API_KEY=xxxxx
# KOYEB_SERVICE_ID=xxxxx

# ============================================
# OPTIONAL: Bot Behavior
# ============================================

# How often to check for new courses (in seconds)
# Default: 180 (3 minutes)
# Recommended: 180-300 (3-5 minutes)
# Don't set too low to avoid rate limiting
CHECK_INTERVAL=180

# Tech news post times (24h, comma-separated) — posts only at these times to activated groups
# Default: 10:00 AM and 10:00 PM
NEWS_POST_TIMES=10:00,22:00

# Timezone for NEWS_POST_TIMES
NEWS_TIMEZONE=Asia/Kolkata

# Background scrape interval (seconds) — queues articles between scheduled posts, does not post
NEWS_SCRAPE_INTERVAL=1800

# Number of articles per tech news digest
NEWS_MIN_ARTICLES=10

# Daily GitHub repos — trending, popular & hidden gems (fresh fetch each slot)
GITHUB_TRENDING_ENABLED=true
GITHUB_TRENDING_TIMES=09:00,11:30,14:00,16:30,19:00
GITHUB_TRENDING_TIMEZONE=Asia/Kolkata
GITHUB_TRENDING_COUNT=5

# Awesome lists (offset from GitHub — one random list per slot)
AWESOME_LISTS_ENABLED=true
AWESOME_LISTS_TIMES=10:15,12:45,15:15,17:45,20:30
AWESOME_LISTS_TIMEZONE=Asia/Kolkata
AWESOME_LISTS_COUNT=5

# Interview Q of the Day (MCQ poll → answer after delay). Groups: /interviewqon
INTERVIEW_Q_ENABLED=true
INTERVIEW_Q_TIMES=13:00,18:00
INTERVIEW_Q_TIMEZONE=Asia/Kolkata
# INTERVIEW_Q_ANSWER_DELAY_MS=1800000

# MongoDB connection string. Keep this secret and set it in your deployment env.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?appName=telegramUdemy

# MongoDB database name. Defaults to telegramUdemy if omitted.
MONGODB_DB_NAME=telegramUdemy

# ============================================
# ADMIN CONFIGURATION
# ============================================

# Owner phone numbers OR LIDs (comma-separated, with country code, no + or spaces)
# Owners have full bot permissions (pause, addadmin, activate groups, etc.)
# 
# NOTE: WhatsApp may use LIDs (Linked IDs) instead of phone numbers for privacy.
# If owner commands don't work, check bot logs for your LID and add it here.
# Example: OWNER_NUMBERS=918830285258,919876543210,195056006897749
OWNER_NUMBERS=

# Moderator phone numbers (comma-separated) — can /activate and /deactivate groups
# Cannot pause bot or manage bot admins. Restart bot after changing.
# Example: MODERATOR_NUMBERS=919123456789,919987654321
MODERATOR_NUMBERS=

# ============================================
# BOT LOGS & NOTIFICATIONS
# ============================================

# Phone number to receive bot startup notifications and movie search logs
# Leave empty (or set to another owner phone) to use "Message yourself" when bot runs on your number
# Example: BOT_LOG_NUMBER=918830285258
BOT_LOG_NUMBER=918830285258

# ============================================
# DAILY GOOD MORNING MESSAGES
# ============================================

# Set to false to disable daily morning messages
MORNING_MESSAGES_ENABLED=true

# Girlfriend's number(s) for daily romantic good morning DM (comma-separated, country code, no +)
# Example: MORNING_MESSAGE_NUMBERS=918830285258
MORNING_MESSAGE_NUMBERS=

# Random daily send window (24h format, local timezone below)
# Picks a new random time between start and end each morning
MORNING_MESSAGE_TIME_START=08:00
MORNING_MESSAGE_TIME_END=10:30

# Timezone for morning message schedule
MORNING_TIMEZONE=Asia/Kolkata

# ============================================
# STICKER FORWARDING
# ============================================

# Groups that receive forwarded stickers (comma-separated @g.us IDs)
# Auto-enabled on startup; you can also use /stickeron / /stickeroff per group
# Example: STICKER_TARGET_GROUPS=120363123456789012@g.us
STICKER_TARGET_GROUPS=

# Parallel sticker workers (1–8, default 3) and delay between sends per worker (ms)
# STICKER_FORWARD_CONCURRENCY=3
# STICKER_INTER_SEND_DELAY_MS=150

# Optional: limit sticker sources to these channels.
# Leave empty = forward from every joined @newsletter channel.
#
# You can paste ANY of these formats (comma-separated):
#   - Channel invite code: 0029Vb6Bu7B6mYPE9OIYqc0O
#   - Full channel URL: https://whatsapp.com/channel/0029Vb6Bu7B6mYPE9OIYqc0O
#   - Resolved JID (bot logs this on startup): 120363282083849178@newsletter
#
# Example — Sticker Central + Cool Whatsapp Stickers:
# STICKER_SOURCE_CHANNELS=0029Vb6Bu7B6mYPE9OIYqc0O,0029ValT8wk9mrGi8cngE13u
STICKER_SOURCE_CHANNELS=

# Sticker pack label shown in WhatsApp
STICKER_PACK_NAME=Course Bot 🤖
STICKER_PACK_AUTHOR=

# ============================================
# TMDB (The Movie Database) — optional
# ============================================
# Free API key for weekly trending movies (real worldwide trending)
# Get yours at https://www.themoviedb.org/settings/api (takes 2 min)
# If not set, weekly trending falls back to user search data
TMDB_API_KEY=

# ============================================
# NVIDIA NIM (trade alerts + group summary)
# ============================================
# NVIDIA_API_KEY=your-nvidia-api-key
# Group recap (/summary) — fast model
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
# Trade alerts (/tradelert, /tradenow) — fallback chain: Gemini → Groq → NVIDIA
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_TRADE_MODEL=gemini-2.5-flash
# GEMINI_TRADE_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash
# GROQ_API_KEY=your-groq-api-key
# GROQ_TRADE_MODEL=llama-3.3-70b-versatile
# GROQ_TRADE_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# NVIDIA_TRADE_MODEL=z-ai/glm-5.2
# TRADE_LLM_PROVIDERS=gemini,groq,nvidia
#
# --- NSE egress (option chain) ------------------------------------------------
# NSE India blocks/bot-challenges foreign datacenter IPs. This bot deploys to
# Render `singapore`, so NSE returns an HTML challenge instead of JSON and the
# option chain shows as "unavailable for NIFTY". Route those requests through an
# India-resident proxy and NSE sees a domestic IP.
#
# Comma-separated, tried in order. Any scheme proxy-agent understands:
#   http://, https://, socks5://, socks4://  — with optional user:pass@
# NSE_PROXY_URL=http://user:pass@1.2.3.4:8080,socks5://5.6.7.8:1080
#
# ScraperAPI fetches the page from an India IP (country_code=in) — the same
# service and the same variable name the sibling tgbot2 project uses, so one key
# serves both. Added automatically to the fallback chain when set, after any
# NSE_PROXY_URL entries. This is the lowest-effort way to get an India egress:
# no VPS to run.
# SCRAPER_API_KEY=
#
# auto (default) — try direct first, fall back to the proxies, and prefer
#                  proxies for 30 min after a direct block so we don't pay the
#                  timeout on every call once we know we're refused
# always         — never go direct (use when the host is known to be blocked)
# off            — ignore proxies entirely
# NSE_PROXY_MODE=auto
#
# With no proxy set, behaviour is unchanged except that a failed fetch now
# serves the last cached chain (clearly labelled STALE with its age) instead of
# failing outright.
# -----------------------------------------------------------------------------

# --- Burst protection for repeated /tradenow ---------------------------------
# Extra keys per provider (comma separated). Free-tier quotas are PER KEY, so a
# second key doubles headroom; the router also raises that provider's RPM budget.
# GEMINI_API_KEYS=key-one,key-two
# GROQ_API_KEYS=key-one,key-two
# NVIDIA_API_KEYS=key-one,key-two
# OPENROUTER_API_KEYS=key-one,key-two
# Per-provider requests/minute budget. Defaults: gemini 8, groq 25, nvidia 35,
# openrouter 15. Requests over budget queue or hop to another provider — they no
# longer fire and eat a 429.
# TRADE_LLM_RPM=gemini:8,groq:25,nvidia:35,openrouter:15
# TRADE_LLM_MAX_CONCURRENT=3
# TRADE_LLM_MAX_PER_PROVIDER=2
# How long a queued request waits for capacity before firing best-effort.
# TRADE_LLM_QUEUE_WAIT_MS=45000
# Repeat `/tradenow SYMBOL` reuses the last result for this long (0 disables).
# Override per call with `/tradenow TCS fresh`.
# TRADENOW_CACHE_TTL_MS=120000
# -----------------------------------------------------------------------------
#
# --- /swing — momentum + 52w breakout swing scan -----------------------------
# Deterministic arithmetic only; no LLM touches the ranking or the levels.
# Ranks the universe by 6M+12M risk-adjusted momentum (NSE Nifty200 Momentum 30
# method), then takes only names breaking out near 52-week highs on expanding
# volume, and only while NIFTY 50 holds its 200 DMA.
#
# Universe override (defaults to the built-in ~250 name NIFTY 200 snapshot):
# SWING_UNIVERSE=RELIANCE,TCS,INFY
# SWING_SCAN_CONCURRENCY=6
# Risk-free rate for the excess-return numerator of the momentum ratio:
# SWING_RISK_FREE_RATE=0.065
# Entry filters:
# SWING_MAX_PCT_FROM_HIGH=5        # must be within 5% of the 52-week high
# SWING_MIN_VOLUME_RATIO=1.5       # breakout volume vs 20-day average
# SWING_MIN_TURNOVER_CR=5          # ₹Cr avg daily turnover — slippage guard
# SWING_MAX_PICKS=5
# SWING_MAX_PER_SECTOR=2           # correlated picks are one bet, not many
# Risk model — position sizing shown in the message:
# SWING_ATR_STOP_MULT=2            # stop = entry − 2×ATR(14)
# SWING_CAPITAL=100000
# SWING_RISK_PCT=0.5               # % of capital risked per trade
#
# NOTE: with ₹1L capital at 0.5% risk, stocks above ~₹3,000 round to 1–3 shares
# and under-use the risk budget; the scan flags this per pick. Raise
# SWING_CAPITAL or SWING_RISK_PCT to size high-priced names properly.
# -----------------------------------------------------------------------------
#
# --- /expiry — expiry-day index options ---------------------------------------
# Post-SEBI (Nov 2024) each exchange runs weeklies on ONE index only:
#   NIFTY      → every Tuesday (weekly) + last Tuesday (monthly)
#   BANKNIFTY / FINNIFTY / MIDCPNIFTY → last Tuesday only, no weeklies
#   SENSEX     → Thursday on BSE. NOT COVERED — BSE exposes no usable public
#                option chain (its endpoint returns an HTML error page).
# Holidays shift expiry to the previous trading day automatically.
#
# Two auto-posts on expiry days, each running the strategy that suits the clock:
#   09:35 → ATM directional on a 15m opening-range break (20% stop, 1:2.5)
#   13:15 → hero-zero deep OTM, with P(ITM) and required move printed on the card
# EXPIRY_ALERT_ENABLED=true
# EXPIRY_MORNING_TIME=09:35
# EXPIRY_AFTERNOON_TIME=13:15
#
# Hero-zero strike band, by absolute delta. Delta ≈ the market's own probability
# of finishing ITM, so 0.02–0.12 means roughly a 2–12% chance. Widening this does
# not improve the odds, it only changes which lottery ticket is shown.
# EXPIRY_HERO_DELTA_MIN=0.02
# EXPIRY_HERO_DELTA_MAX=0.12
# EXPIRY_HERO_MAX_PREMIUM=25
#
# Directional ATM trade parameters:
# EXPIRY_ATM_STOP_PCT=20
# EXPIRY_ATM_T1_PCT=50
# EXPIRY_ATM_T2_PCT=100
# EXPIRY_MIN_RANGE_EXPANSION=0.3   # break must extend 30% beyond the OR
#
# Lot sizes change at SEBI revisions — override when they do:
# EXPIRY_LOT_SIZES=NIFTY:75,BANKNIFTY:30,FINNIFTY:65,MIDCPNIFTY:120
# -----------------------------------------------------------------------------
# Every source posts at TRADE_ALERT_TIME by default — a breakout entry decays
# fast, so a later post means filling above the level.
#
# The cost for heatmap2: at 09:20 only the forming 09:15 bar exists, so v2 gives
# its watchlist (live movers, sector-aligned, beating NIFTY) but no entry/stop/
# target — those need the 09:15 range closed plus a confirming bar.
# Set this to ALSO get a later post carrying real levels; when set, heatmap2
# groups move off the main slot so there is no double morning post. Keep the
# times between 09:45 and 12:00 (post-noon breaks tested at 37% and negative
# expectancy). v1 / legacy / nse always stay on the main slot.
# TRADE_ALERT_HEATMAP2_TIMES=09:50,11:15
#
# Morning volatility scan — runs AFTER market opens (default 09:35 IST).
# The pre-market scan at 09:20 uses stale pre-open data. This second clock
# fires 20 minutes after open, when the opening range has closed and real
# intraday moves are visible. It re-runs discovery with fresh data, so stocks
# that only became movers after the open appear here.
# Groups already posted at 09:20 skip duplicate symbols.
# TRADE_ALERT_MORNING_VOLATILITY_TIME=09:35
#
# Discovery source. heatmap (v1) stays the default; switch a single group with
# `/tradelert source heatmap2` to trial v2 without changing anyone else.
# TRADE_ALERT_DISCOVERY_SOURCE=heatmap
# TRADE_ALERT_DISCOVERY_SOURCE=heatmap2
# TRADE_ALERT_DISCOVERY_SOURCE=nse
# TRADE_ALERT_DISCOVERY_SOURCE=legacy
# TRADE_ALERT_NSE_GL_EACH=5
# TRADE_ALERT_HEATMAP_MAX=8
# TRADE_ALERT_HEATMAP_MIN_MOVE_PCT=2
#
# Heatmap v2 — selects on the LIVE intraday move, not the pre-open gap, so a
# lower floor here is stricter than v1's ±2% was against stale data.
# HEATMAP_V2_MIN_MOVE_PCT=1.5
# Score >= 60 measured 47.5-51.1% win rate against 42.1% below it over 22
# sessions x 230 symbols. Lowering this re-admits the bucket that tested as
# dead weight; check `/tradelert stats` before changing it.
# HEATMAP_V2_MIN_SCORE=60
# HEATMAP_V2_MAX_PER_SECTOR=3
# HEATMAP_V2_CONCURRENCY=6
#
# Outcome resolution — grades posted alerts against what price actually did.
# Without it every alert stays PENDING and the win rate is unknowable.
# -----------------------------------------------------------------------------
# Member broadcast pacing (/broadcast)
# -----------------------------------------------------------------------------
# WhatsApp limits accounts that send lots of cold DMs, and it keys mostly off
# recipient blocks and spam reports. Defaults are deliberately slow: randomised
# gaps (a fixed cadence is a machine signature) and a hard daily ceiling.
# Anyone replying STOP is suppressed permanently.
# BROADCAST_MIN_GAP_MS=8000
# BROADCAST_MAX_GAP_MS=25000
# BROADCAST_BATCH_SIZE=20
# BROADCAST_DAILY_CAP=150
#
# TRADE_OUTCOME_RESOLVER_ENABLED=true
# TRADE_OUTCOME_RESOLVE_TIME=16:15
# ASSIST_OWNER_NAME=Jacky
# Optional bio the AI shares when people ask about you (defaults to a short creator blurb)
# ASSIST_OWNER_ABOUT=Jacky — creator of this WhatsApp bot. Based in India. DM for premium/movies help.
# ASSIST_GEMINI_MODEL=gemini-2.5-flash
# ASSIST_GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.5-pro
# ASSIST_GROQ_MODEL=llama-3.1-8b-instant
# ASSIST_GROQ_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile
# ASSIST_LLM_PROVIDERS=gemini,groq,nvidia,openrouter
# TRADE_LLM_PROVIDERS=gemini,groq,nvidia,openrouter

# ============================================
# TELEGRAM STICKER IMPORT (/tgstickers)
# ============================================
# Telegram Bot API token — required for /tgstickers command.
# Create a bot via @BotFather on Telegram, then paste the token here.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ============================================
# OPENROUTER (fallback when Gemini/Groq/NVIDIA fail)
# Used by: group summary, trade alerts, /assist
# ============================================
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,qwen/qwen3-coder:free

# ============================================
# NOTES
# ============================================
# 
# - Keep this file private (it's in .gitignore)
# - Don't share your chat IDs publicly
# - Course history, groups, admins, and WhatsApp session data are stored in MongoDB
# - Check bot.log for detailed logs
# - Group admins are auto-detected (no manual configuration needed)
#

# ============================================
# CONTINUOUS /tradenow AUTO-TRIGGER
# ============================================
# Re-runs the /tradenow analysis through the session and auto-posts to
# /tradelert groups when a side clears the confidence threshold.
#
# IMPORTANT: the gate is the *model's own* "Primary Confidence" figure from the
# analysis prompt — a self-assessment produced fresh each call, NOT a measured
# win rate, and never calibrated against outcomes. Every firing is journalled to
# trade_alert_outcomes, so after a few weeks `/tradelert stats` will show this
# trigger's real hit rate. Use that number to set the threshold, not this one.
#
# OFF by default: each scan costs a full LLM analysis call per index.
TRADENOW_AUTO_ENABLED=false
# TRADENOW_AUTO_INDICES=NIFTY
# TRADENOW_AUTO_MIN_CONF=65
# TRADENOW_AUTO_INTERVAL_MIN=5
# Anti-spam: per index+side cooldown, and a hard cap on alerts per day.
# TRADENOW_AUTO_COOLDOWN_MIN=30
# TRADENOW_AUTO_MAX_PER_DAY=6
# Ceiling on analysis calls per day — the free LLM tiers are shared with
# /tradelert, /summary and the rest of the bot.
# TRADENOW_AUTO_MAX_SCANS_PER_DAY=60
